{
    "name": "nuxt-devtools-observatory",
    "version": "0.5.0",
    "description": "Nuxt DevTools: useFetch Dashboard, provide/inject Graph, Composable Tracker, Pinia Tracker, Render Heatmap, Transition Tracker, Trace Viewer",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/victorlmneves/nuxt-devtools-observatory.git"
    },
    "homepage": "https://github.com/victorlmneves/nuxt-devtools-observatory#readme",
    "type": "module",
    "packageManager": "pnpm@10.28.2",
    "main": "./dist/module.mjs",
    "module": "./dist/module.mjs",
    "exports": {
        ".": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        },
        "./runtime/composable-registry": {
            "types": "./dist/runtime/composables/composable-registry.d.ts",
            "import": "./dist/runtime/composables/composable-registry.js"
        },
        "./runtime/provide-inject-registry": {
            "types": "./dist/runtime/composables/provide-inject-registry.d.ts",
            "import": "./dist/runtime/composables/provide-inject-registry.js"
        },
        "./runtime/fetch-registry": {
            "types": "./dist/runtime/composables/fetch-registry.d.ts",
            "import": "./dist/runtime/composables/fetch-registry.js"
        },
        "./runtime/async-data-instrumentation": {
            "types": "./dist/runtime/instrumentation/asyncData.d.ts",
            "import": "./dist/runtime/instrumentation/asyncData.js"
        }
    },
    "files": [
        "dist",
        "client"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "dev": "concurrently -r -n client,nuxt \"pnpm dev:client\" \"nuxi dev playground\"",
        "dev:client": "vite build --watch --config client/vite.config.ts",
        "docs:clean": "rm -rf docs/.nuxt docs/.output",
        "docs:dev": "pnpm docs:clean && pnpm --dir docs dev",
        "docs:build": "pnpm docs:clean && pnpm --dir docs build",
        "docs:generate": "pnpm docs:clean && pnpm --dir docs generate",
        "docs:preview": "pnpm --dir docs preview",
        "build:client": "vite build --config client/vite.config.ts",
        "build": "npm run build:client && nuxt-module-build build",
        "prepack": "npm run build",
        "prepare": "husky",
        "release": "semantic-release",
        "lint": "eslint .",
        "format": "prettier --write '**/*.{ts,vue,js,json}' --ignore-path .prettierignore && stylelint '**/*.{css,vue}' --ignore-pattern '**/.nuxt/**' --ignore-pattern '**/.output/**' --ignore-pattern 'coverage/**' --ignore-pattern 'client/dist/**' --ignore-pattern 'scripts/**' --ignore-pattern 'docs/dist/**' --fix && eslint --fix '**/*.{ts,vue,js}' --ignore-pattern '**/.nuxt/**' --ignore-pattern '**/.output/**' --ignore-pattern 'coverage/**' --ignore-pattern 'client/dist/**' --ignore-pattern 'scripts/**' --ignore-pattern 'docs/dist/**'",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p client/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:screenshots": "playwright test scripts/playwright/screenshot-trackers.spec.ts",
        "test:e2e": "playwright test scripts/playwright/playground-pages.spec.ts",
        "capture:screenshots": "node scripts/playwright/capture-observatory-screenshots.cjs",
        "verify": "tsx scripts/run-verification.ts",
        "verify:debug": "playwright test --debug",
        "verify:ui": "playwright test --ui",
        "verify:trace": "playwright test --trace on",
        "verify:report": "playwright show-report",
        "test:accuracy": "vitest run tests/verification/accuracy.test.ts",
        "type-check": "tsc --noEmit --project tests/verification/tsconfig.json"
    },
    "dependencies": {
        "@babel/generator": "^7.29.1",
        "@babel/parser": "^7.29.0",
        "@babel/traverse": "^7.29.0",
        "@babel/types": "^7.29.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^9.39.2",
        "@nuxt/devtools-kit": "4.0.0-alpha.3",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/kit": "^3.0.0",
        "@nuxt/module-builder": "^1.0.3",
        "@nuxt/schema": "^3.0.0",
        "@pinia/nuxt": "^0.11.3",
        "@playwright/test": "^1.63.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@tanstack/vue-virtual": "^3.13.39",
        "@types/babel__generator": "^7.27.0",
        "@types/babel__traverse": "^7.28.0",
        "@types/node": "^25.5.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^4.1.0",
        "@vitest/ui": "^4.1.4",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^62.5.0",
        "eslint-plugin-jsonc": "^2.21.0",
        "eslint-plugin-regexp": "^3.3.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "husky": "^9.1.7",
        "nuxt": "^3.0.0 || ^4.0.0",
        "pinia": "^3.0.4",
        "playwright": "^1.63.0",
        "postcss-html": "^1.8.1",
        "prettier": "^3.9.8",
        "semantic-release": "^25.0.9",
        "sinon": "^21.1.2",
        "sirv": "^3.0.2",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-vue": "^1.0.0",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "unbuild": "^3.6.1",
        "vite": "^6.4.1",
        "vitest": "^4.1.0",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.2.2"
    },
    "keywords": [
        "nuxt",
        "devtools",
        "vue",
        "performance",
        "debugging"
    ],
    "peerDependencies": {
        "@nuxt/kit": "^3.0.0 || ^4.0.0"
    }
}
