# Same names as the module (`OBSERVATORY_*`). Nuxt loads this file for the playground.
# Tracker tabs default to on except Pinia (`OBSERVATORY_PINIA_TRACKER=true` to enable).
# Uncomment to override.
#
# OBSERVATORY_FETCH_DASHBOARD=true
# OBSERVATORY_PROVIDE_INJECT_GRAPH=true
# OBSERVATORY_COMPOSABLE_TRACKER=true
# OBSERVATORY_PINIA_TRACKER=true
# OBSERVATORY_RENDER_HEATMAP=true
# OBSERVATORY_TRANSITION_TRACKER=true
# OBSERVATORY_TRACE_VIEWER=true
# OBSERVATORY_INSTRUMENT_SERVER=true
# OBSERVATORY_HEATMAP_HIDE_INTERNALS=false

OBSERVATORY_MAX_FETCH_ENTRIES=200
OBSERVATORY_FETCH_PAGE_SIZE=20
OBSERVATORY_MAX_PAYLOAD_BYTES=10000
OBSERVATORY_MAX_TRANSITIONS=500
OBSERVATORY_MAX_COMPOSABLE_HISTORY=50
OBSERVATORY_MAX_COMPOSABLE_ENTRIES=300
OBSERVATORY_MAX_RENDER_TIMELINE=100
OBSERVATORY_HEATMAP_THRESHOLD_COUNT=3
OBSERVATORY_HEATMAP_THRESHOLD_TIME=16
