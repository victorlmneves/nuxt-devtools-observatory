{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "lib": ["ESNext", "DOM"],
        "paths": {
            "@observatory/*": ["./src/*"],
            "@observatory-client/*": ["./client/src/*"],
            "@observatory-tests/*": ["./tests/*"]
        },
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "tests/**/*.ts", "vitest.config.ts"],
    "exclude": ["src/runtime/test-bridge.ts"]
}
